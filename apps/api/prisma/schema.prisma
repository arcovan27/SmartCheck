generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MAINTENANCE
  OPERATOR
  SAFETY
}

enum ChecklistResponseType {
  OK_PROBLEM_NA
  YES_NO
  NUMBER
  TEXT
}

enum ChecklistItemResult {
  OK
  PROBLEM
  NA
  YES
  NO
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenancePlanTriggerType {
  DAYS
  KM
  HOURMETER
}

enum MaintenancePlanAlertState {
  OK
  NEAR
  DUE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  employeeId   String   @unique
  employee     Employee @relation(fields: [employeeId], references: [id])
  epiDeliveriesGiven EpiDelivery[] @relation("DeliveriesByUser")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id                String        @id @default(cuid())
  name              String
  registration      String        @unique
  department        String
  function          String
  active            Boolean       @default(true)
  biometricTemplate String?
  user              User?
  epiDeliveries     EpiDelivery[]
  checklistRuns     ChecklistExecution[] @relation("ChecklistOperator")
  maintenances      Maintenance[] @relation("MaintenanceResponsible")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Epi {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  active      Boolean       @default(true)
  deliveries  EpiDelivery[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model EpiDelivery {
  id               String      @id @default(cuid())
  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [id])
  epiId            String
  epi              Epi         @relation(fields: [epiId], references: [id])
  quantity         Int
  caNumber         String
  deliveredAt      DateTime
  deliveredByUserId String?
  deliveredByUser  User?       @relation(fields: [deliveredByUserId], references: [id], name: "DeliveriesByUser")
  notes            String?
  attachments      Attachment[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Equipment {
  id                String               @id @default(cuid())
  name              String
  type              String
  department        String
  model             String?
  serialNumber      String?              @unique
  hourmeter         Float?
  mileage           Float?
  active            Boolean              @default(true)
  checklistTemplates ChecklistTemplate[]
  checklistRuns     ChecklistExecution[]
  maintenances      Maintenance[]
  maintenancePlans  MaintenancePlan[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model ChecklistTemplate {
  id            String                  @id @default(cuid())
  name          String
  description   String?
  periodicity   String
  equipmentId   String
  equipment     Equipment               @relation(fields: [equipmentId], references: [id])
  items         ChecklistTemplateItem[]
  executions    ChecklistExecution[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model ChecklistTemplateItem {
  id             String                @id @default(cuid())
  templateId     String
  template       ChecklistTemplate     @relation(fields: [templateId], references: [id])
  label          String
  instruction    String?
  responseType   ChecklistResponseType
  position       Int
  required       Boolean               @default(true)
  createsMaintenanceOnProblem Boolean  @default(true)
  executionItems ChecklistExecutionItem[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model ChecklistExecution {
  id            String                   @id @default(cuid())
  templateId    String
  template      ChecklistTemplate        @relation(fields: [templateId], references: [id])
  equipmentId   String
  equipment     Equipment                @relation(fields: [equipmentId], references: [id])
  operatorId    String
  operator      Employee                 @relation("ChecklistOperator", fields: [operatorId], references: [id])
  executedAt    DateTime                 @default(now())
  notes         String?
  hadProblem    Boolean                  @default(false)
  items         ChecklistExecutionItem[]
  maintenances  Maintenance[]
  attachments   Attachment[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model ChecklistExecutionItem {
  id               String              @id @default(cuid())
  executionId      String
  execution        ChecklistExecution  @relation(fields: [executionId], references: [id])
  templateItemId   String
  templateItem     ChecklistTemplateItem @relation(fields: [templateItemId], references: [id])
  result           ChecklistItemResult?
  numericValue     Float?
  textValue        String?
  problemDescription String?
  attachments      Attachment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Maintenance {
  id                 String              @id @default(cuid())
  equipmentId        String
  equipment          Equipment           @relation(fields: [equipmentId], references: [id])
  type               MaintenanceType
  description        String
  status             MaintenanceStatus   @default(OPEN)
  priority           MaintenancePriority @default(MEDIUM)
  responsibleId      String?
  responsible        Employee?           @relation("MaintenanceResponsible", fields: [responsibleId], references: [id])
  checklistExecutionId String?
  checklistExecution ChecklistExecution? @relation(fields: [checklistExecutionId], references: [id])
  openedAt           DateTime            @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  history            String?
  attachments        Attachment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model MaintenancePlan {
  id                 String                   @id @default(cuid())
  equipmentId        String
  equipment          Equipment                @relation(fields: [equipmentId], references: [id])
  title              String
  description        String?
  triggerType        MaintenancePlanTriggerType
  threshold          Float
  nearThreshold      Float?
  lastExecutionDate  DateTime?
  lastExecutionValue Float?
  active             Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

model Attachment {
  id                     String                 @id @default(cuid())
  filename               String
  mimeType               String
  path                   String
  checklistExecutionId   String?
  checklistExecution     ChecklistExecution?    @relation(fields: [checklistExecutionId], references: [id])
  checklistExecutionItemId String?
  checklistExecutionItem ChecklistExecutionItem? @relation(fields: [checklistExecutionItemId], references: [id])
  maintenanceId          String?
  maintenance            Maintenance?           @relation(fields: [maintenanceId], references: [id])
  epiDeliveryId          String?
  epiDelivery            EpiDelivery?           @relation(fields: [epiDeliveryId], references: [id])
  createdAt              DateTime               @default(now())
}
